{
  "name": "@ashmitasa/ashmita-vuln-scanner",
  "version": "1.0.3",
  "description": "A CLI tool that scans folders and git history for leaked secrets like API keys and passwords",
  "main": "index.js",
  "files": [
    "index.js",
    "scan.js",
    "src/",
    "README.md"
  ],
  "type": "commonjs",
  "bin": {
    "vuln-scanner": "index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node index.js",
    "scan": "node index.js scan",
    "prepare": "husky"
  },
  "keywords": [
    "security",
    "cli",
    "scanner",
    "git",
    "secret"
  ],
  "author": "Ashmita",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.1.0"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
